# Secrets: any env variant, but keep the committed template
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage

# The name `streamlit_app.py` gives a downloaded report (`research-<thread>-<utc>.md`).
# These are the user's reports, not source, and a browser can save them into the repo.
research-*.md

# uv / virtualenv
.venv/

# Build output (the project builds with hatchling)
dist/
build/

# macOS
.DS_Store

# Local agent state (checkpoints + persistent memory)
.deep_research/

# Streamlit: `.streamlit/config.toml` IS committed (it is the app's theme, a project
# fact). `secrets.toml` is never committed — this project reads credentials from `.env`
# via `config.py`'s `load_dotenv()`, so nothing here needs the file, but Streamlit's own
# convention is to put API keys in it and the ignore has to exist BEFORE someone follows
# that convention rather than after.
.streamlit/secrets.toml

# Claude Code: `.claude/settings.json` and `.claude/hooks/` ARE committed (they
# encode project facts, not preferences). Personal overrides are not.
.claude/settings.local.json
